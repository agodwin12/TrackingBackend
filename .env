# ╔══════════════════════════════════════════════════════════╗
# ║         PROXYM TRACKING - ENVIRONMENT VARIABLES          ║
# ╚══════════════════════════════════════════════════════════╝

# ========== ENVIRONMENT ==========
NODE_ENV=development
# Options: development | production | staging

# ========== SERVER ==========
PORT=5000
HOST=0.0.0.0
# For production, set HOST to your domain or IP

# ========== FLUTTER APP DOMAIN (CORS) ==========
# Set this to your Flutter app's domain in production
FLUTTER_APP_DOMAIN=https://your-flutter-app.com
# For development, CORS allows localhost automatically

# ========== DATABASE ==========
DB_HOST=localhost
DB_NAME=wego1
DB_USER=root
DB_PASSWORD=
# For production, use strong password and secure host

# ========== SECURITY ==========
JWT_SECRET=tracking2024
# ⚠️ IMPORTANT: Change this to a strong random string in production
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

JWT_EXPIRES_IN=7d
# JWT token expiration time (e.g., 7d, 24h, 30m)

# ========== GOOGLE MAPS ==========
GOOGLE_MAPS_API_KEY=AIzaSyBn88TP5X-xaRCYo5gYxvGnVy_0WYotZWo
# Restrict this key in Google Cloud Console for production

# ========== REDIS CACHE ==========
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# For production, set REDIS_PASSWORD for security

# ========== SOCKET.IO ==========
SOCKET_PORT=3000
# This is informational; Socket.IO runs on same port as HTTP server

# ========== GPS TRACKING ACCOUNT 1 ==========
GPS_LOGIN_NAME_1=Proxym_tracking
GPS_LOGIN_PASSWORD_1=proxym123

# ========== GPS TRACKING ACCOUNT 2 ==========
GPS_LOGIN_NAME_2=PROXYM
GPS_LOGIN_PASSWORD_2=Proxym2024.

# ========== GPS API CONFIGURATION ==========
GPS_LOGIN_URL=http://appzzl.18gps.net/
GPS_API_URL=http://apitest.18gps.net/GetDateServices.asmx
GPS_FETCH_INTERVAL=5000
# Interval in milliseconds (5000 = 5 seconds)

GPS_LOGIN_TYPE=ENTERPRISE
GPS_LANGUAGE=en
GPS_TIMEZONE=8
GPS_MAP_TYPE=WGS84

# ========== TRACKING CONFIGURATION ==========
LOCATION_UPDATE_INTERVAL=5000
# How often to update locations (milliseconds)

MOVEMENT_THRESHOLD_METERS=50
# Minimum distance to consider vehicle as "moved"

# ========== TRIP DETECTION ==========
TRIP_IDLE_MINUTES=0.5
# How long vehicle must be idle to end trip (minutes)

TRIP_MIN_SPEED_KMH=1
# Minimum speed to consider vehicle as moving

TRIP_MIN_DURATION=1
# Minimum trip duration in minutes

TRIP_MIN_DISTANCE_KM=0.2
# Minimum trip distance in kilometers

# ========== RATE LIMITING ==========
RATE_LIMIT_GENERAL=500
# Max requests per 15 minutes for general API

RATE_LIMIT_AUTH=5
# Max login attempts per 15 minutes

RATE_LIMIT_OTP=3
# Max OTP requests per hour

RATE_LIMIT_TRACKING=60
# Max tracking requests per minute

# ========== SMS/OTP SERVICE (Techsoft or Twilio) ==========
SMS_PROVIDER=techsoft
# Options: techsoft | twilio

# Techsoft SMS Configuration
TECHSOFT_SMS_API_URL=https://www.techsoft-web-agency.com/smsservice/api_sms.php
TECHSOFT_SMS_USERNAME=your_techsoft_username
TECHSOFT_SMS_PASSWORD=your_techsoft_password

# Twilio Configuration (alternative)
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number

# ========== FIREBASE CLOUD MESSAGING (Push Notifications) ==========
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_PRIVATE_KEY_ID=your_key_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour_Private_Key_Here\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your_client_id

# Alternatively, use Firebase service account JSON file path
FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-service-account.json

# ========== EMAIL SERVICE (Optional) ==========
EMAIL_PROVIDER=gmail
# Options: gmail | sendgrid | mailgun

# Gmail Configuration
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your_app_password

# SendGrid Configuration (alternative)
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@proxymtracking.com

# ========== LOGGING ==========
LOG_LEVEL=debug
# Options: error | warn | info | debug
# Use 'error' or 'warn' in production for performance

LOG_FILE_PATH=./logs
# Directory for log files

LOG_MAX_SIZE=20m
# Maximum size of each log file

LOG_MAX_FILES=14d
# Keep logs for 14 days

# ========== GEOCODING SERVICE ==========
GEOCODING_CACHE_DURATION=86400
# Cache geocoding results for 24 hours (in seconds)

# ========== ALERT CONFIGURATION ==========
ALERT_COOLDOWN_MINUTES=5
# Minimum time between duplicate alerts

SAFE_ZONE_CHECK_INTERVAL=10
# How often to check safe zone violations (seconds)

GEOFENCE_CHECK_INTERVAL=10
# How often to check geofence violations (seconds)

SPEED_ALERT_THRESHOLD=120
# Default speed limit in km/h for alerts

# ========== CLEANUP/MAINTENANCE ==========
OLD_DATA_RETENTION_DAYS=90
# Keep old GPS data for 90 days

CLEANUP_INTERVAL_HOURS=24
# Run cleanup job every 24 hours

# ========== CLUSTERING (PM2) ==========
CLUSTER_MODE=false
# Set to 'true' for production with PM2 clustering

CLUSTER_INSTANCES=4
# Number of instances (0 = max CPUs, or specify number)

# ========== HEALTH CHECK ==========
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=60
# Health check interval in seconds

# ========== REQUEST LIMITS ==========
REQUEST_BODY_LIMIT=10mb
# Maximum request body size

REQUEST_TIMEOUT=30000
# Request timeout in milliseconds

# ========== CORS CONFIGURATION ==========
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://10.0.2.2:5000
# Comma-separated list of allowed origins for development

# ========== DATABASE CONNECTION POOL ==========
DB_POOL_MAX=10
# Maximum number of connections in pool

DB_POOL_MIN=2
# Minimum number of connections in pool

DB_POOL_ACQUIRE=30000
# Maximum time (ms) to acquire connection

DB_POOL_IDLE=10000
# Maximum time (ms) connection can be idle

# ========== SESSION CONFIGURATION ==========
SESSION_SECRET=your_session_secret_change_this
# Session secret for cookie encryption

SESSION_COOKIE_MAX_AGE=86400000
# Session cookie expiration (24 hours in milliseconds)

# ========== BACKUP CONFIGURATION ==========
BACKUP_ENABLED=false
# Enable automated database backups

BACKUP_INTERVAL_HOURS=24
# Backup interval in hours

BACKUP_PATH=./backups
# Directory for backup files

# ========== MONITORING & METRICS ==========
METRICS_ENABLED=false
# Enable Prometheus metrics endpoint

METRICS_PORT=9090
# Prometheus metrics port

# ========== DEBUG FLAGS ==========
DEBUG_SQL=false
# Log all SQL queries (use in development only)

DEBUG_SOCKET=false
# Log all Socket.IO events (use in development only)

DEBUG_GPS=true
# Log GPS data processing

# ========== TIMEZONE ==========
TZ=Africa/Douala
